 'use strict';
 
+// Bound recursive AST walkers even when an AST is supplied directly.
+exports.MAX_DEPTH = 256;
+exports.assertDepth = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  while (pending.length) {
+    const { node, depth } = pending.pop();
+    if (depth > exports.MAX_DEPTH) {
+      throw new SyntaxError('Brace nesting exceeds maximum depth (256)');
+    }
+    if (node.nodes) {
+      for (const child of node.nodes) pending.push({ node: child, depth: depth + 1 });
+    }
+  }
+};
