--- a/__tests__/contracts/stroke-batching.ts
+++ b/__tests__/contracts/stroke-batching.ts
@@ -9 +9 @@ interface Packing {
-    stride: 1 | 3,
+    stride: 0 | 1 | 3,
@@ -131,0 +132,40 @@ export function strokePackingContract(packing: Packing, stride: 1 | 3) {
+  it('solid pages preserve exact geometry while omitting even reads of dash travel', () => {
+    const points = Object.freeze([
+      1 / 3,
+      -0,
+      32,
+      3,
+      4,
+      12,
+      5,
+      6,
+      8,
+      7,
+      8,
+      16,
+      9,
+      10,
+      0,
+    ]);
+    const placement = [1e20, -1 / 7, -0] as const;
+    const expected = packing.packStrokeInstances(
+      [{ points, travel: [0, 1, 2, 3, 4, 5], translationAndOrder: placement }],
+      stride,
+    );
+    const part = {
+      points,
+      translationAndOrder: placement,
+      get travel(): readonly number[] {
+        throw new Error('Solid pages do not read travel');
+      },
+    };
+    const actual = packing.packStrokeInstances([part], 0);
+    expect(new Uint8Array(actual.points.buffer)).toEqual(
+      new Uint8Array(expected.points.buffer),
+    );
+    expect(actual.travel).toHaveLength(0);
+    const saved = actual.points.slice();
+    const next = packing.packStrokeInstances([part, part], 0);
+    expect(next.points.buffer).not.toBe(actual.points.buffer);
+    expect(actual.points).toEqual(saved);
+  });
