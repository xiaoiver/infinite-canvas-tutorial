new file mode 100644
index 0000000..ddb8e9e
--- /dev/null
+++ b/packages/core/src/utils/stroke-texture.ts
@@ -0,0 +1,167 @@
+import {
+  type Device,
+  type Buffer,
+  type Texture,
+  type Sampler,
+  Format,
+  BufferUsage,
+  BufferFrequencyHint,
+  TextureUsage,
+  AddressMode,
+  FilterMode,
+  MipmapFilterMode,
+} from '@antv/g-device-api';
+import { acquireStrokePageConstants } from './stroke-page-buffers';
+import type { StrokePart } from './stroke-batching';
+
+/** Page-owned geometry; no shared mutable slots or entity references. */
+export function packStrokeTexture(parts: readonly StrokePart[], stride: 1 | 3) {
+  let pointCount = 0,
+    rows = 0;
+  for (const p of parts) {
+    if (p.points.length % 3 !== 0) return undefined;
+    pointCount += Math.ceil(p.points.length / 3);
+    rows += Math.max(0, Math.ceil(p.points.length / 3 - 3));
+  }
+  // One MiB per page, including row padding; oversized pages use packed geometry.
+  const width = 256,
