diff --git a/__tests__/contracts/stroke-texture.ts b/__tests__/contracts/stroke-texture.ts
new file mode 100644
index 0000000..71439aa
--- /dev/null
+++ b/__tests__/contracts/stroke-texture.ts
@@ -0,0 +1,199 @@
+/** Independent decoding and ownership contract for both backend implementations. */
+export function strokeTextureContract(
+  pack: any,
+  Page: any,
+  supports: any,
+  legacy: any,
+) {
+  const parts = () => [
+    {
+      points: [-0, 0, 0, 1, 2, 4, 3, 4, 8, 5, 6, 16, 7, 8, 20],
+      travel: [1, 2, 3, 4, 5, 6],
+      translationAndOrder: [20, 30, 4],
+    },
+    {
+      points: [10, 10, 0, 11, 12, 12, 13, 14, 8, 15, 16, 16],
+      travel: [7, 8, 9],
+      translationAndOrder: [40, 50, 6],
+    },
+  ];
+  it.each([1, 3])(
+    'decodes exact Float32 geometry, travel and placement without joining owners, stride=%s',
+    (stride) => {
+      const p = parts(),
+        a = pack(p, stride),
+        b = legacy(p, stride),
+        decoded: number[] = [],
+        travel: number[] = [];
+      for (let row = 0; row < a.rows; row++) {
+        const offset = a.instances[row * a.instanceStride];
+        for (let point = 0; point < 4; point++)
+          for (let c = 0; c < 3; c++)
+            decoded.push(a.geometry[(offset + point) * 4 + c]);
+        decoded.push(
+          ...a.instances.slice(
+            row * a.instanceStride + 1,
+            row * a.instanceStride + 4,
+          ),
+        );
+        travel.push(
+          ...a.instances.slice(
+            row * a.instanceStride + 4,
+            row * a.instanceStride + 4 + stride,
+          ),
+        );
+      }
+      expect(new Uint32Array(new Float32Array(decoded).buffer)).toEqual(
+        new Uint32Array(b.points.buffer),
+      );
+      expect(new Uint32Array(new Float32Array(travel).buffer)).toEqual(
+        new Uint32Array(b.travel.buffer),
+      );
+    },
+  );
+  it('falls back before allocating an oversized, empty or malformed page', () => {
+    expect(pack([], 1)).toBeUndefined();
+    expect(pack([{ ...parts()[0], points: [0, 1, 2, 3] }], 1)).toBeUndefined();
+    expect(
+      pack([{ ...parts()[0], points: Array(200001).fill(0) }], 1),
+    ).toBeUndefined();
+    const device = {
+      queryVendorInfo: () => ({ platformString: 'WebGL1' }),
+      queryTextureFormatSupported: jest.fn(),
+    };
+    expect(supports(device, pack(parts(), 1))).toBe(false);
+    expect(device.queryTextureFormatSupported).not.toHaveBeenCalled();
+  });
+  const setup = () => {
+    const resources: any[] = [];
+    const resource = (kind: string, descriptor: any) => {
+      const r: any = {
+        kind,
+        descriptor,
+        destroy: jest.fn(),
+        pixels: undefined,
+        bytes: undefined,
+      };
+      r.setImageData = jest.fn((data: any[]) => {
+        r.pixels = data[0].slice();
+      });
+      r.setSubData = jest.fn((_offset: number, bytes: Uint8Array) => {
+        r.bytes = bytes.slice();
+      });
+      resources.push(r);
+      return r;
+    };
+    const device = {
+      createBuffer: jest.fn((d: any) => resource('buffer', d)),
+      createTexture: jest.fn((d: any) => resource('texture', d)),
+      createSampler: jest.fn((d: any) => resource('sampler', d)),
+    };
+    const page = new Page(device);
+    const close = () => {
+      page.destroy();
+      page.destroy();
+      for (const r of resources) expect(r.destroy).toHaveBeenCalledTimes(1);
+    };
+    return { page, device, resources, close };
+  };
+  it('retains unchanged geometry while updating current instance placement', () => {
+    const h = setup();
+    try {
+      const p = parts();
+      h.page.update(pack(p, 3));
+      const t = h.page.texture,
+        b = h.page.buffer;
+      p[0].translationAndOrder[0] = 100;
+      const next = pack(p, 3);
+      h.page.update(next);
+      expect(h.page.texture).toBe(t);
+      expect(h.page.buffer).toBe(b);
+      expect(t.setImageData).toHaveBeenCalledTimes(1);
+      expect(b.setSubData).toHaveBeenCalledTimes(2);
+      expect(b.bytes).toEqual(new Uint8Array(next.instances.buffer));
+    } finally {
+      h.close();
+    }
+  });
+  it.each([false, true])(
+    'invalidates same-handle geometry after a partial upload failure, retry=%s',
+    (retry) => {
+      const h = setup();
+      try {
+        const p = parts();
+        h.page.update(pack(p, 1));
+        const t = h.page.texture;
+        p[0].points[3] = 99;
+        t.setImageData.mockImplementationOnce((data: any[]) => {
+          t.pixels[0] = data[0][0];
+          throw Error('partial geometry');
+        });
+        expect(() => h.page.update(pack(p, 1))).toThrow('partial geometry');
+        expect(t.destroy).not.toHaveBeenCalled();
+        if (retry) {
+          const next = pack(p, 1);
+          h.page.update(next);
+          expect(t.setImageData).toHaveBeenCalledTimes(3);
+          expect(t.pixels).toEqual(next.geometry);
+        }
+      } finally {
+        h.close();
+      }
+    },
+  );
+  it('keeps previous storage on failed growth and retries without publishing dead handles', () => {
+    const h = setup();
+    try {
+      h.page.update(pack(parts(), 1));
+      const t = h.page.texture,
+        b = h.page.buffer;
+      const p = Array.from({ length: 256 }, () => parts()[0]);
+      const next = pack(p, 1);
+      h.device.createBuffer.mockImplementationOnce(() => {
+        throw Error('instance growth');
+      });
+      expect(() => h.page.update(next)).toThrow('instance growth');
+      expect(h.page.texture).toBe(t);
+      expect(h.page.buffer).toBe(b);
+      expect(t.destroy).not.toHaveBeenCalled();
+      h.page.update(next);
+      expect(h.page.rows).toBe(next.rows);
+      expect(t.destroy).toHaveBeenCalledTimes(1);
+    } finally {
+      h.close();
+    }
+  });
+  it('shares only immutable constants and keeps live peer storage independent', () => {
+    const h = setup(),
+      peer = new Page(h.device);
+    try {
+      h.page.update(pack(parts(), 3));
+      peer.update(pack(parts(), 3));
+      expect(h.page.constants.index).toBe(peer.constants.index);
+      expect(h.page.texture).not.toBe(peer.texture);
+      h.page.destroy();
+      expect(peer.constants.index.destroy).not.toHaveBeenCalled();
+      peer.update(pack(parts(), 3));
+      peer.destroy();
+    } finally {
+      peer.destroy();
+      h.close();
+    }
+  });
+  it('releases constants if sampler allocation fails before a page is constructed', () => {
+    const resources: any[] = [];
+    const device = {
+      createBuffer: () => {
+        const r = { destroy: jest.fn() };
+        resources.push(r);
+        return r;
+      },
+      createSampler: () => {
+        throw Error('sampler allocation');
+      },
+    };
+    expect(() => new Page(device)).toThrow('sampler allocation');
+    expect(resources).toHaveLength(2);
+    for (const r of resources) expect(r.destroy).toHaveBeenCalledTimes(1);
+  });
+}
