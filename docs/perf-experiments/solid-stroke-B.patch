+for (const batched of [false, true])
+  test(`compiles Core and ECS ${
+    batched ? 'solid page' : 'full stroke'
+  } shaders through the WebGPU path`, async ({ page }) => {
+    await page.goto('/shader-compiler.html');
+    await page.waitForFunction(() => !!window.shaderCompilerRegression);
+    const programs = await page.evaluate(
+      (batched) => window.shaderCompilerRegression.compileStrokePages(batched),
+      batched,
+    );
+    expect(programs.map((p) => p.backend)).toEqual(['core', 'ecs']);
+    for (const program of programs) {
+      expect(program.vertex).toContain('@vertex');
+      expect(program.fragment).toContain('@fragment');
+      if (batched) expect(program.vertex).not.toContain('a_Travel');
+      else expect(program.vertex).toContain('a_Travel');
+    }
+  });
diff --git a/__tests__/browser/stroke-batching.spec.ts b/__tests__/browser/stroke-batching.spec.ts
index 7c49165..367a6af 100644
--- a/__tests__/browser/stroke-batching.spec.ts
+++ b/__tests__/browser/stroke-batching.spec.ts
@@ -286,0 +287,36 @@ for (const backend of ['core', 'ecs'] as const) {
+    test('solid and dashed edits switch streams without changing full-path pixels', async ({
+      page,
+    }) => {
+      await scene(page, backend, 1);
+      await enable(page, backend, true);
+      for (const [dashed, offset] of [
+        [false, 0],
+        [true, 3],
+        [false, 27],
+        [true, -4],
+        [false, 0],
+      ] as const) {
+        await page.evaluate(
+          async ({ backend, dashed, offset }) => {
+            const patch = {
+              d: 'M0 0L120 0L120 80',
+              strokeWidth: 6,
+              strokeDasharray: dashed ? [9, 6] : [],
+              strokeDashoffset: offset,
+            };
+            if (backend === 'core') window.corePathInstances.mutate(0, patch);
+            else
+              await window.polylineLOD.patch({
+                ...patch,
+                strokeDasharray: patch.strokeDasharray.join(' '),
+              });
+          },
+          { backend, dashed, offset },
+        );
+        expect((await state(page, backend)).strokePages).toBe(dashed ? 0 : 1);
+        const optimized = await page.locator('canvas').screenshot();
+        await enable(page, backend, false);
+        compare(await page.locator('canvas').screenshot(), optimized);
+        await enable(page, backend, true);
+      }
+    });
