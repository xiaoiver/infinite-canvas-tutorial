      "yaml@>=1 <1.10.3": "^1.10.3",
      "lodash@<4.18.0": "^4.18.0",
      "tough-cookie@<4.1.3": "^4.1.3",
      "@loaders.gl/textures>texture-compressor": "-",
      "@loaders.gl/images": "4.5.2"
    }
  },
  "packageManager": "pnpm@9.15.9"
}
