      "@xmldom/xmldom": "^0.9.12",
      "postcss": "^8.5.23",
      "fast-uri": "^3.1.6",
      "ip-address": "^10.3.1",
      "mermaid": "11.16.1",
      "sharp": "^0.35.4",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "jsonata@<1.8.9": "^1.8.9",
      "@ai-sdk/provider-utils@>=4 <4.0.33": "^4.0.33",
      "browserslist@<4.28.7": "^4.28.7",
      "@humanfs/node@<0.16.8": "^0.16.8",
