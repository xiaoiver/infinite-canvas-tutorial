    "@types/jest": "^26.0.24",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vue-macros/eslint-config": "^0.7.1",
    "@xmldom/xmldom": "^0.9.12",
    "canvas": "^3.1.0",
    "case-police": "^0.5.14",
    "eslint": "^9",
    "eslint-plugin-jest": "24.3.6",
    "globals": "^16.0.0",
    "grapheme-splitter": "^1.0.4",
    "husky": "^7.0.4",
    "jest": "^29.7.0",
    "jsdom": "^19.0.0",
    "lint-staged": "^10.5.4",
    "markdownlint-cli": "^0.32.2",
    "npm-run-all": "^4.1.5",
    "openfig-core": "^0.3.7",
    "pixelmatch": "5.3.0",
    "pngjs": "^6.0.0",
    "pngparse-sync": "^1.0.2",
    "prettier": "^2.8.8",
    "rimraf": "^4.4.1",
    "ts-jest": "^29.3.1",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vue-eslint-parser": "^9.4.3"
  },
  "optionalDependencies": {
    "gl": "^6.0.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.12",
      "playwright": "1.55.1",
      "lodash-es": ">=4.18.0",
      "qs": "^6.16.0",
      "rollup": ">=4.59.0",
