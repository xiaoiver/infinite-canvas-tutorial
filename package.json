      "shell-quote@<1.9.0": "^1.9.0",
      "linkify-it@<5.0.2": "^5.0.2",
      "body-parser@>=2 <2.3.0": "^2.3.0",
      "vite": "^6.4.3",
      "@babel/core@<7.29.6": "^7.29.6",
      "ws@>=8 <8.21.0": "^8.21.0",
      "form-data@>=2 <3": "^2.5.6",
      "form-data@>=4 <4.0.6": "^4.0.6",
      "tmp@<0.2.6": "^0.2.6",
      "uuid@>=10 <11.1.1": "11.1.1",
